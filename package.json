{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npm install && npm run db:up && npm run prisma:generate && npm run migrate:deploy",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:all": "npm run db:up && npm run prisma:generate && npm run migrate:deploy && npm run dev",
    "start:docker": "docker compose up --build",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:studio": "npx prisma studio",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "prisma": "6.19.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
